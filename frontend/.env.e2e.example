# Credentials for the Playwright browser tests (npm run test:e2e).
# Copy to .env.e2e (git-ignored) and fill in. A test that needs an account
# that isn't set here is skipped, not failed.

# Admin console account (php artisan admin:create).
E2E_ADMIN_USER=head_admin
E2E_ADMIN_PASSWORD=password

# Optional: an app (user_details) account, e.g. a head.
E2E_APP_USER=
E2E_APP_PASSWORD=
