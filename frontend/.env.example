# Absolute base URL for the Laravel API, including the /api/v1 prefix.
#
# Local dev: leave this unset. Vite proxies /api to http://127.0.0.1:8000
# (see vite.config.ts), so the relative default in src/lib/api.ts is correct
# and no .env file is needed.
#
# Deployed: the SPA (Vercel) and the API (Render) are on different hosts, so
# this must be set in the Vercel project's environment variables:
#
#   VITE_API_BASE_URL=https://api.lensnstories.com/api/v1
#
# Vite inlines VITE_* values at build time, so changing it requires a
# redeploy, not just a restart.
