    "paths": {
        "/api/fitem-boxes": {
            "get": {
                "tags": [
                    "Fitem Boxes"
                ],
                "summary": "Get all fitem boxes",
                "operationId": "getFitemBoxes",
                "responses": {
                    "200": {
                        "description": "Fitem boxes retrieved successfully"
                    }
                }
            },
            "post": {
                "tags": [
                    "Fitem Boxes"
                ],
                "summary": "Create a new fitem box",
                "operationId": "createFitemBox",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "box_name",
                                    "item_id",
                                    "is_active",
                                    "added_by"
                                ],
                                "properties": {
                                    "box_name": {
                                        "type": "string",
                                        "example": "Box A"
                                    },
                                    "item_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "is_active": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "added_by": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Fitem box created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
