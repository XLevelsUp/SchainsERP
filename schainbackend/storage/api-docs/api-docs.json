        "/api/user-details": {
            "get": {
                "tags": [
                    "User Details"
                ],
                "summary": "Get all user details",
                "description": "Returns all user details",
                "operationId": "getAllUserDetails",
                "responses": {
                    "200": {
                        "description": "User details retrieved successfully"
                    }
                }
            },
            "post": {
                "tags": [
                    "User Details"
                ],
                "summary": "Create user detail",
                "description": "Create a new user detail with Aadhar image",
                "operationId": "createUserDetail",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "name",
                                    "user_name",
                                    "password_hash",
                                    "address",
                                    "signature",
                                    "code",
                                    "phone_no",
                                    "proff",
                                    "role_id",
                                    "mailing_name",
                                    "category_name",
                                    "system_id",
                                    "is_customerfitem_cal_enabled",
                                    "is_customerfitem_cal_in_enabled"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Mohamed Azar"
                                    },
                                    "user_name": {
                                        "type": "string",
                                        "example": "azar"
                                    },
                                    "password_hash": {
                                        "type": "string",
                                        "example": "123456"
                                    },
                                    "address": {
                                        "type": "string",
                                        "example": "Chennai"
                                    },
                                    "signature": {
                                        "type": "string",
                                        "example": "AZ"
                                    },
                                    "code": {
                                        "type": "string",
                                        "example": "EMP001"
                                    },
                                    "phone_no": {
                                        "type": "string",
                                        "example": "9876543210"
                                    },
                                    "remarks": {
                                        "type": "string",
                                        "example": "Test user",
                                        "nullable": true
                                    },
                                    "proff": {
                                        "type": "string",
                                        "example": "Employee"
                                    },
                                    "role_id": {
                                        "type": "string",
                                        "example": "Admin"
                                    },
                                    "customer_commants": {
                                        "type": "string",
                                        "example": "Customer comments",
                                        "nullable": true
                                    },
                                    "mailing_name": {
                                        "type": "string",
                                        "example": "Mohamed Azar"
                                    },
                                    "image_url": {
                                        "type": "string",
                                        "example": "profile/image.jpg",
                                        "nullable": true
                                    },
                                    "profile_image": {
                                        "type": "string",
                                        "format": "binary",
                                        "nullable": true
                                    },
                                    "aadhar_image": {
                                        "description": "Aadhar front and back images can be uploaded",
                                        "type": "string",
                                        "format": "binary",
                                        "nullable": true
                                    },
                                    "category_name": {
                                        "type": "string",
                                        "example": "GRAMS",
                                        "enum": [
                                            "GRAMS",
                                            "PURITY",
                                            "BOTH"
                                        ]
                                    },
                                    "system_id": {
                                        "type": "string",
                                        "example": "SYS001"
                                    },
                                    "is_active": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "is_delete": {
                                        "type": "boolean",
                                        "example": false
                                    },
                                    "is_billable": {
                                        "type": "boolean",
                                        "example": false
                                    },
                                    "is_create_order_shown": {
                                        "type": "boolean",
                                        "example": false
                                    },
                                    "is_salary_person": {
                                        "type": "boolean",
                                        "example": false
                                    },
                                    "is_gold_cal_enabled": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "is_cash_cal_enabled": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "is_wastage_cal_enabled": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "is_customerfitem_cal_enabled": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "is_customerfitem_cal_in_enabled": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "is_otp_verified": {
                                        "type": "boolean",
                                        "example": false
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User detail created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
