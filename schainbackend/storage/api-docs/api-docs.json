        "/api/items": {
            "get": {
                "tags": [
                    "Items"
                ],
                "summary": "Get all items",
                "description": "Returns all items from the database",
                "operationId": "getItems",
                "responses": {
                    "200": {
                        "description": "Items retrieved successfully"
                    }
                }
            },
            "post": {
                "tags": [
                    "Items"
                ],
                "summary": "Create a new item",
                "description": "Create a new item in the database",
                "operationId": "createItem",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "item_name"
                                ],
                                "properties": {
                                    "item_name": {
                                        "type": "string",
                                        "example": "Gold Ring"
                                    },
                                    "is_active": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "default_touch": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 92
                                    },
                                    "item_touch": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 90
                                    },
                                    "added_at": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-07-23 10:30:00"
                                    },
                                    "is_need_fitem_shown": {
                                        "type": "boolean",
                                        "example": false
                                    },
                                    "mtouch": {
                                        "type": "number",
                                        "format": "double",
                                        "example": 91.5,
                                        "nullable": true
                                    },
                                    "is_barcode": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "is_no_barcode": {
                                        "type": "boolean",
                                        "example": false
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Item created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
